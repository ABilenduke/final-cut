APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=backend
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=redis
SESSION_CONNECTION=session
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=finalcut.test
SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=redis
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_SCHEME=tls
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379
# Path to CA cert for Redis TLS (verify_peer=true in config/database.php).
# In Docker dev this is set via docker-compose.yml; only needed here for non-Docker setups.
# REDIS_TLS_CA_CERT=/tls/redis/ca.pem

MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="noreply@finalcut.test"
MAIL_FROM_NAME="${APP_NAME}"

FINANCE_NOTIFICATION_EMAIL=finance@finalcut.test

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Frontend URL (CORS)
FRONTEND_URL=https://finalcut.test

# Sanctum Stateful Domains (SPA cookie auth)
SANCTUM_STATEFUL_DOMAINS=finalcut.test

# Disable browser-facing Laravel Boost routes in local API development
BOOST_ENABLED=false
BOOST_BROWSER_LOGS_WATCHER=false

# DatabaseSeeder personal-admin override — only consulted in local/testing.
# Defaults to the project owner's dev credentials; override on forks/CI.
# SEEDER_ADMIN_EMAIL=
# SEEDER_ADMIN_NAME=
# SEEDER_ADMIN_PASSWORD=

# TMDB
TMDB_API_KEY=

# Stripe
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=

# Admin panel (Filament) domain scoping
# APP_PRIMARY_DOMAIN gates the customer api/web routes; ADMIN_DOMAIN gates the
# Filament panel routes. Both are asserted by RouteDomainScopingTest.
APP_PRIMARY_DOMAIN=finalcut.test
ADMIN_DOMAIN=admin.finalcut.test

# Admin session isolation. ScopeAdminSession middleware rewrites session.cookie,
# session.domain, and session.connection for requests inside the admin panel so
# admin sessions never collide with customer (Sanctum) sessions.
ADMIN_SESSION_COOKIE=final_cut_admin_session
ADMIN_SESSION_DOMAIN=admin.finalcut.test
ADMIN_SESSION_CONNECTION=session_admin

# Redis DB index for the admin session_admin connection. Defaults to 3 so it
# stays disjoint from the customer session (2), cache (1), and default (0).
REDIS_ADMIN_SESSION_DB=3

# Default timezone pre-selected in the LocationResource create form. Leave
# blank to fall back to app.timezone (usually UTC) — the form still requires
# the admin to make a conscious selection on create. Set this only if you
# want new locations to default to a specific IANA zone (e.g.
# "America/New_York") instead of UTC.
DEFAULT_LOCATION_TIMEZONE=

# Admin loyalty adjustments with an absolute delta at or above this value
# surface an elevated confirmation modal on the Adjust Points action. The
# activity log + this threshold are the v1 compensating controls for
# large-delta corrections (dual-control approval is deferred to v2).
LOYALTY_LARGE_ADJUSTMENT_THRESHOLD=1000
