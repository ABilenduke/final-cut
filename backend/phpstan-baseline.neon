parameters:
	ignoreErrors:
		# TimestampColumns is called statically (TimestampColumns::standardTimestamps())
		# not mixed in via `use`, so PHPStan's trait.unused detection still fires.
		# FormatsCurrency dropped from the baseline in Plan 04 once it was `use`'d
		# inside UpcomingShowtimesRelationManager.
		-
			message: '#^Trait App\\Filament\\Concerns\\TimestampColumns is used zero times and is not analysed\.$#'
			identifier: trait.unused
			count: 1
			path: app/Filament/Concerns/TimestampColumns.php

		-
			message: '#^Cannot call method isPast\(\) on string\.$#'
			identifier: method.nonObject
			count: 3
			path: app/Http/Controllers/Api/BookingController.php

		-
			message: '#^Property App\\Models\\Booking\:\:\$payment_method \(string\|null\) does not accept App\\Enums\\PaymentMethod\.$#'
			identifier: assign.propertyType
			count: 1
			path: app/Http/Controllers/Api/BookingController.php

		-
			message: '#^Property App\\Models\\Booking\:\:\$status \(string\) does not accept App\\Enums\\BookingStatus\:\:Confirmed\.$#'
			identifier: assign.propertyType
			count: 2
			path: app/Http/Controllers/Api/BookingController.php

		-
			message: '#^Cannot access property \$value on string\.$#'
			identifier: property.nonObject
			count: 1
			path: app/Http/Controllers/Api/FoodMenuController.php

		-
			message: '#^Access to an undefined property App\\Models\\Seat\:\:\$computed_price\.$#'
			identifier: property.notFound
			count: 1
			path: app/Http/Controllers/Api/ShowtimeController.php

		-
			message: '#^Access to an undefined property App\\Models\\Seat\:\:\$computed_status\.$#'
