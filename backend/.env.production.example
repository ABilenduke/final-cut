# ─────────────────────────────────────────────────────────────────────────────
# Production environment example for the Final Cut backend.
#
# Copy to `backend/.env` on the production host and fill in real values.
# Never commit a real `.env` — only this template.
#
# This file documents the production environment variables this deployment
# template expects. Stock Laravel keys (QUEUE_CONNECTION, CACHE_STORE,
# SESSION_LIFETIME, etc.) are intentionally omitted — they're already
# documented in backend/.env.example and resolve from sensible defaults
# in `config/*.php`. If a NEW variable becomes required in production
# specifically (admin hardening, prod-only integrations), add it here in
# the same commit so the deploy host always has the canonical reference.
# ─────────────────────────────────────────────────────────────────────────────

# ── App ──────────────────────────────────────────────────────────────────────
APP_NAME="Final Cut"
APP_ENV=production
APP_DEBUG=false
APP_KEY=                                                # php artisan key:generate
APP_URL=https://finalcut.com
APP_TIMEZONE=UTC

# Customer / admin domain split. Both are asserted by the
# RouteDomainScopingTest Pest case so a misconfigured deploy is caught
# at boot rather than at first request.
APP_PRIMARY_DOMAIN=finalcut.com
ADMIN_DOMAIN=admin.finalcut.com

# ── Database ─────────────────────────────────────────────────────────────────
DB_CONNECTION=pgsql
DB_HOST=
DB_PORT=5432
DB_DATABASE=final_cut
DB_USERNAME=
DB_PASSWORD=
DB_SSLMODE=verify-full
DB_SSLROOTCERT=/tls/postgres/ca.pem

# ── Redis (cache + session + queue) ──────────────────────────────────────────
REDIS_HOST=
REDIS_PORT=6379
REDIS_USERNAME=
REDIS_PASSWORD=
REDIS_SCHEME=tls
REDIS_TLS_CA_CERT=/tls/redis/ca.pem

# Customer + admin session isolation. Customer sessions live on the primary
# domain; admin sessions live on the admin subdomain. Different cookie
# names + a dedicated Redis DB index keep the two stores fully disjoint.
SESSION_DRIVER=redis
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
ADMIN_SESSION_COOKIE=final_cut_admin_session
ADMIN_SESSION_DOMAIN=admin.finalcut.com                 # NO leading dot
ADMIN_SESSION_CONNECTION=session_admin
REDIS_ADMIN_SESSION_DB=3

# ── Admin IP allowlist (Plan 09) ─────────────────────────────────────────────
# Comma-separated list of IPv4 addresses or CIDR blocks allowed to reach the
# admin panel. REQUIRED in production. Enforced at TWO layers:
#   1. nginx (rendered into admin.conf via the entrypoint)
#   2. Laravel middleware (App\Http\Middleware\AdminIpAllowlist)
#
# Posture: fail-closed by default. Empty value in production = every admin
# request returns 403 with an error-level log line.
#
# v1 is IPv4-only. IPv6 ingress is rejected at the middleware layer with a
# logged warning; adding IPv6 support requires updating the middleware, the
# nginx allow/deny block, and adding a parallel ip6tables-multiport
# Fail2ban jail in the same change.
ADMIN_IP_ALLOWLIST=                                     # e.g., 203.0.113.0/24,198.51.100.10

# Emergency fail-open. Time-boxed escape hatch for the deploy chicken-and-egg
# (you cannot reach the panel to set the allowlist if the allowlist starts
# empty). Setting this to true bypasses the layer-2 check when the allowlist
# is empty, and emits an error-level log on EVERY request so the bypass can
# never be silent.
#
#   false (default) → fail closed if allowlist empty. Production resting state.
#   true            → allow all when allowlist empty; logs error-level per-request.
#
# Deploy sequences:
#   Preferred: set ADMIN_IP_ALLOWLIST before the first request, never flip
#              this flag.
#   Bootstrap: set ADMIN_IP_ALLOWLIST_EMERGENCY_OPEN=true with empty
#              ADMIN_IP_ALLOWLIST → deploy → verify access from an expected
#              IP → set the real allowlist → flip this back to false →
#              restart. Every request during this window is logged at
#              error level.
ADMIN_IP_ALLOWLIST_EMERGENCY_OPEN=false

# ── Operational tunables ─────────────────────────────────────────────────────
# Loyalty point adjustments with an absolute delta at or above this value
# surface an elevated confirmation modal in the admin Adjust Points action.
LOYALTY_LARGE_ADJUSTMENT_THRESHOLD=1000

# Recipient for finance-side notifications (gift card voids, etc.). Point
# at an internal distribution list with appropriate access controls — the
# payload includes recipient email + remaining balance (PII).
FINANCE_NOTIFICATION_EMAIL=finance@finalcut.com

# Default IANA timezone applied to newly-created Location rows when the
# admin form leaves the field blank. Existing locations are never mutated.
DEFAULT_LOCATION_TIMEZONE=America/New_York

# ── Mail ─────────────────────────────────────────────────────────────────────
MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="no-reply@finalcut.com"
MAIL_FROM_NAME="Final Cut"

# ── Stripe ───────────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# ── TMDB (movie metadata enrichment, offline-only) ───────────────────────────
TMDB_API_KEY=

# ── Logging ──────────────────────────────────────────────────────────────────
LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=info
LOG_DAILY_DAYS=14

# ── Activity log retention ───────────────────────────────────────────────────
# Used by the daily `activitylog:clean` schedule. Aligned with the dispatch
# outbox prune (also 14 days) so an incident review can correlate "what
# happened" with "what was emitted" over the same window.
ACTIVITY_LOGGER_DELETE_RECORDS_OLDER_THAN_DAYS=14

# ── Boost (dev only — must be off in prod) ───────────────────────────────────
BOOST_ENABLED=false
BOOST_BROWSER_LOGS_WATCHER=false
