# OCSP stapling — proves the certificate isn't revoked by fetching a
# signed response from the CA and attaching it to the TLS handshake.
#
# This file is only mounted in production via docker-compose.prod.yml.
#
# Requirements:
#   - A CA-signed certificate (will NOT work with self-signed certs)
#   - ssl_trusted_certificate must point to the intermediate chain file
#     only (chain.pem), NOT the fullchain. With Let's Encrypt / Certbot
#     this is /etc/letsencrypt/live/<domain>/chain.pem.
#
# If using the certbot/certbot Docker image with the --nginx plugin,
# Certbot will automatically set ssl_certificate and ssl_certificate_key
# paths. This snippet only needs ssl_trusted_certificate pointed at the
# chain file.
#
# This file is processed by envsubst (rendered to /etc/nginx/snippets/ocsp.conf
# by the nginx command) and included inside the HTTPS server block.
# APP_DOMAIN is substituted automatically — no manual changes needed.
#
# NOTE: no `resolver` here on purpose. This snippet is included into a server
# block that already declares `resolver 127.0.0.11` (Docker's embedded DNS),
# and nginx rejects a duplicate `resolver` in the same context ([emerg]). OCSP
# stapling uses that existing resolver to reach the CA's responder.

ssl_stapling            on;
ssl_stapling_verify     on;
ssl_trusted_certificate /etc/letsencrypt/live/${APP_DOMAIN}/chain.pem;
