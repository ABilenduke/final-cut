NUXT_PUBLIC_API_BASE_URL=https://finalcut.test
NUXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
NUXT_PUBLIC_CDN_BASE_URL=https://cdn.example.com/finalcut
# Base URL for SEO, OG tags, sitemap (nuxt.config runtimeConfig.public.siteUrl)
NUXT_PUBLIC_SITE_URL=https://finalcut.test
# Date-only UI timezone for SSR-safe "today" (runtimeConfig.public.appTimeZone)
NUXT_PUBLIC_APP_TIME_ZONE=America/New_York
