APP_DOMAIN=finalcut.test

# Optional CDN origin used by nginx CSP img-src. Backend storage URL resolution
# is configured in backend/.env* with the same DO_SPACES_URL variable.
DO_SPACES_URL=

DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=final_cut
DB_USERNAME=final_cut
DB_PASSWORD=secret

DB_TEST_DATABASE=final_cut_test

REDIS_HOST=redis
REDIS_PORT=6379
REDIS_USERNAME=app
REDIS_PASSWORD=redissecret
REDIS_SCHEME=tls
