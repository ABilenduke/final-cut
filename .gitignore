# OS files
.DS_Store
Thumbs.db

# IDE
.idea
.fleet
.vscode
.zed

# Environment files
.env
.env.*
!.env.example

# Logs
logs
*.log

# Committed Fail2ban sample logs are dev-convenience snapshots used to
# locally run `fail2ban-regex`. CI regenerates the authoritative sample on
# every run; the committed file is the offline fallback.
!fail2ban/filter.d/*.sample.log

# Node (safety net)
node_modules

# SSL certificates (generated per-developer)
nginx/certs/*.pem
nginx/certs/*.key
nginx/certs/.domain

# Git worktrees
.worktrees

# Claude Code: commit shared project config (skills/agents/commands/settings.json),
# but keep personal/runtime files (settings.local.json, scheduled_tasks.lock, etc.)
# out of the repo. .dockerignore still excludes the whole .claude/ tree from build
# contexts so this doesn't bloat container images.
.claude/*
!.claude/skills/
!.claude/agents/
!.claude/commands/
!.claude/settings.json
